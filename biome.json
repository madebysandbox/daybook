{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": ["**", "!.next", "!node_modules", "!app/styles/tokens.css", "!app/styles/tokens.usage.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["ds/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/**", "app/**", "../../**"],
                    "message": "The design system never imports from the app. Import other components through @ds/*, or move the code into ds/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["app/styles/motion.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ]
}
